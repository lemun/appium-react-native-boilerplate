{
  "name": "appium-react-native-boilerplate",
  "version": "2.0.0",
  "private": true,
  "description": "WebdriverIO 10 + Appium 3 + Mocha boilerplate for cross-platform React Native E2E tests, wired to the public WebdriverIO native demo app",
  "author": "Shai Sinai",
  "license": "MIT",
  "homepage": "https://github.com/lemun/appium-react-native-boilerplate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemun/appium-react-native-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/lemun/appium-react-native-boilerplate/issues"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "react-native",
    "e2e",
    "mobile-testing",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "app:download": "node scripts/download-app.ts",
    "doctor": "node scripts/doctor.ts",
    "setup:validate": "npm run doctor",
    "ios": "wdio run wdio.ios.conf.ts",
    "android": "wdio run wdio.android.conf.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "report": "allure generate allure-results --open",
    "test:unit": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@wdio/allure-reporter": "^10.0.1",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/types": "^10.0.1",
    "allure": "^3.20.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.18.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-wdio": "^10.0.1",
    "expect-webdriverio": "^8.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "webdriverio": "^10.0.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
