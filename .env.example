# Copy to .env (WebdriverIO loads it automatically). Every variable is optional:
# with an empty .env the suite runs against the pinned WebdriverIO demo app on default devices.

# --- iOS (XCUITest) ---
# Simulator name from `xcrun simctl list devices available` (default: iPhone 17 Pro)
IOS_DEVICE_NAME=
# Runtime version, e.g. 26.5; empty lets XCUITest pick a matching simulator
IOS_PLATFORM_VERSION=
# Pin an exact simulator by UDID instead of name/version
IOS_UDID=
# faceId (default, Face ID devices) or touchId (Touch ID devices such as iPhone SE)
IOS_BIOMETRIC_TYPE=

# --- Android (UiAutomator2) ---
# AVD name from `emulator -list-avds`; when set, Appium boots the emulator for you
ANDROID_AVD=
# Device label shown in logs (default: Android Emulator)
ANDROID_DEVICE_NAME=
# Android version of the device, e.g. 15; empty means "whatever is connected"
ANDROID_PLATFORM_VERSION=
# Target one device when several are connected (`adb devices`)
ANDROID_UDID=
# Screen-lock PIN set by the fingerprint enrollment helper (default: 1234)
DEVICE_PIN=
# Fingerprint ids used by the biometric specs (defaults: 1 = enrolled, 2 = unknown finger)
FINGERPRINT_ID=
WRONG_FINGERPRINT_ID=

# --- Your own app instead of the demo app ---
# Path to a .app/.zip (iOS simulator build) or .apk; screen objects must match your app
APP_PATH=
# Bundle id (iOS) or package name (Android) of that app, used by relaunchApp
APP_ID=

# --- Misc ---
# Locale of the UI copy used in assertions (src/i18n/<locale>.json, default: en)
APP_LOCALE=
# Retry a failed spec file N times (default: 0)
SPEC_FILE_RETRIES=
